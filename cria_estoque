import csv 
import os 
dados = "produtos.csv"

def inicial():

    if not os.path.exists(dados):
       with open(dados,'w',newline='',encoding='utf-8') as arq :
        escreve = csv.writer(arq)
        escreve.writerow(['nome','preco','tipo'])



def cria_um_estoque():
    objeto = inicial()

